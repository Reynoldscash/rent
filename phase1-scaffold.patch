new file mode 100644
index 0000000..e5d242e
--- /dev/null
+++ b/lib/auth/getUser.ts
@@ -0,0 +1,7 @@
+import { createClient } from "@/lib/supabase/server";
+
+export async function getUser() {
+  const supabase = await createClient();
+  const { data } = await supabase.auth.getUser();
+  return data.user;
+}
diff --git a/lib/storage/getSignedUrl.ts b/lib/storage/getSignedUrl.ts
new file mode 100644
index 0000000..0394d78
--- /dev/null
+++ b/lib/storage/getSignedUrl.ts
@@ -0,0 +1,6 @@
+import { createClient } from "@/lib/supabase/server";
+
+export async function getSignedUrl(bucket: string, path: string, expiresInSeconds = 60) {
+  const supabase = await createClient();
+  return supabase.storage.from(bucket).createSignedUrl(path, expiresInSeconds);
+}
diff --git a/lib/storage/uploadPrivate.ts b/lib/storage/uploadPrivate.ts
new file mode 100644
index 0000000..bc8a79b
--- /dev/null
+++ b/lib/storage/uploadPrivate.ts
@@ -0,0 +1,9 @@
+import { createClient } from "@/lib/supabase/server";
+
+export async function uploadPrivate(bucket: string, path: string, file: File) {
+  const supabase = await createClient();
+  return supabase.storage.from(bucket).upload(path, file, {
+    contentType: file.type,
+    upsert: false,
+  });
+}
