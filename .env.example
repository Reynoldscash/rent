# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon (legacy) key or the newer publishable key — either works here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by Stripe webhook / system routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the site (used in auth email links).
# Local: http://localhost:3000   Vercel: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (server only) — needed from the payments step onward. Use test-mode keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
